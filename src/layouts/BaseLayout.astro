---
import { getCollection } from "astro:content";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  progress?: boolean;
  /** 사이드바에서 현재 위치를 표시할 때 씁니다. */
  here?: "posts" | "archive" | "about";
}
const {
  title,
  description = "문제를 정의하고 서비스로 증명해온 기록. 정답이 하나가 아닌 자리에서 고른 이유와 버린 이유를 직접 잰 숫자와 함께 적습니다.",
  progress = false,
  here = "posts",
} = Astro.props;

// 사이드바는 모든 페이지에 같은 모양으로 서기 때문에 여기서 한 번만 센다.
const posts = await getCollection("posts", ({ data }) => !data.draft);
const order = ["케이톡", "레인보우TV", "아주이벤트", "메일상자", "아올다 클라우드", "공통", "회고"];
const counts = new Map<string, number>();
posts.forEach((p) => counts.set(p.data.project, (counts.get(p.data.project) ?? 0) + 1));
const projects = order
  .filter((p) => counts.has(p))
  .map((p) => ({ name: p, count: counts.get(p)! }));
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Noto+Serif+KR:wght@500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    {/* 테마를 페인트 전에 확정해 깜빡임을 막습니다 */}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        if (dark) document.documentElement.dataset.theme = "dark";
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#content">본문으로 건너뛰기</a>
    {progress && <div class="read-progress"><i id="read-progress"></i></div>}

    <div class="app">
      <aside class="rail">
        <a class="rail__me" href="/">
          <b>김휘래</b>
          <span>SERVER ENGINEER</span>
        </a>

        <nav class="rail__nav" aria-label="사이트">
          <a href="/" aria-current={here === "posts" ? "page" : undefined}>
            <span>글</span><span class="tnum">{posts.length}</span>
          </a>
          <a href="/archive/" aria-current={here === "archive" ? "page" : undefined}>
            <span>아카이브</span>
          </a>
          <a href="/about/" aria-current={here === "about" ? "page" : undefined}>
            <span>소개</span>
          </a>
        </nav>

        <div class="rail__group" role="group" aria-label="프로젝트">
          <p class="rail__label">PROJECTS</p>
          <a href="/" data-filter="all"><span>전체</span><b class="tnum">{posts.length}</b></a>
          {projects.map((p) => (
            <a href={`/?project=${encodeURIComponent(p.name)}`} data-filter={p.name}>
              <span>{p.name}</span><b class="tnum">{p.count}</b>
            </a>
          ))}
        </div>

        <div class="rail__links">
          <a href="https://github.com/rlagnlfo1004" rel="me noopener">GitHub ↗</a>
          <a href="https://rlagnlfo1004.tistory.com" rel="noopener">Tistory ↗</a>
          <a href="mailto:hramst0618@gmail.com">이메일 ↗</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="테마 전환">
            테마 <kbd>D</kbd>
          </button>
        </div>
      </aside>

      <div class="app__body">
        <slot />

        <footer class="site-footer">
          고른 이유와 버린 이유를 같이 적습니다.
        </footer>
      </div>
    </div>

    <script>
      const root = document.documentElement;
      const setTheme = (t: string) => {
        root.dataset.theme = t === "dark" ? "dark" : "";
        localStorage.setItem("theme", t);
      };
      const toggle = () =>
        setTheme(root.dataset.theme === "dark" ? "light" : "dark");

      document.getElementById("theme-toggle")?.addEventListener("click", toggle);
      document.addEventListener("keydown", (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const el = e.target as HTMLElement;
        if (el?.closest("input, textarea, [contenteditable]")) return;
        if (e.key === "d" || e.key === "D" || e.key === "ㅇ") toggle();
      });

      // 읽기 진행률
      const bar = document.getElementById("read-progress");
      if (bar) {
        const update = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.width = max > 0 ? `${Math.min(100, (scrollY / max) * 100)}%` : "0%";
        };
        addEventListener("scroll", update, { passive: true });
        addEventListener("resize", update);
        update();
      }

      // 코드 블록: 언어 라벨 + 복사 버튼 + 줄 번호
      document.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
        if (pre.closest(".code-block")) return;
        const lang = pre.dataset.language ?? "code";
        const file = pre.getAttribute("data-file");

        const wrap = document.createElement("div");
        wrap.className = "code-block";
        pre.parentNode?.insertBefore(wrap, pre);

        const bar = document.createElement("div");
        bar.className = "code-block__bar";
        bar.innerHTML =
          `<span class="code-block__lang">${file ? `${lang} · ${file}` : lang}</span>`;

        const copy = document.createElement("button");
        copy.type = "button";
        copy.className = "code-block__copy";
        copy.textContent = "복사";
        copy.addEventListener("click", async () => {
          await navigator.clipboard.writeText(pre.innerText);
          copy.textContent = "복사됨";
          copy.dataset.copied = "";
          setTimeout(() => {
            copy.textContent = "복사";
            delete copy.dataset.copied;
          }, 1600);
        });
        bar.appendChild(copy);

        wrap.append(bar, pre);
        pre.setAttribute("data-lines", "");
      });
    </script>
  </body>
</html>
