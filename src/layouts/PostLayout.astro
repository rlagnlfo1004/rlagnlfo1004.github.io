---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
  title: string;
  description: string;
  project: string;
  date: Date;
  readingMinutes?: number;
  headings: MarkdownHeading[];
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { title, description, project, date, readingMinutes, headings, prev, next } =
  Astro.props;

const dateText = date.toLocaleDateString("ko-KR", {
  year: "numeric", month: "2-digit", day: "2-digit",
});
---
<BaseLayout title={title} description={description} progress>
  <div class="shell">
    <main id="content">
      <article>
        <div class="post-meta">
          <span class="chip">{project}</span>
          <time class="tnum" datetime={date.toISOString()}>{dateText}</time>
          {readingMinutes && <><span>·</span><span>읽는 데 {readingMinutes}분</span></>}
        </div>

        <h1 class="post-title">{title}</h1>
        <p class="post-lead">{description}</p>

        <div class="prose">
          <slot />
        </div>
      </article>

      {(prev || next) && (
        <nav class="post-nav">
          {prev && (
            <a href={`/posts/${prev.slug}/`}>
              <span>← 이전 글</span><b>{prev.title}</b>
            </a>
          )}
          {next && (
            <a href={`/posts/${next.slug}/`}>
              <span>다음 글 →</span><b>{next.title}</b>
            </a>
          )}
        </nav>
      )}
    </main>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
