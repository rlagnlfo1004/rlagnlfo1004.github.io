---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const order = ["케이톡", "레인보우TV", "아주이벤트", "메일상자", "아올다 클라우드", "선착순예매", "공통", "회고"];
const counts = new Map<string, number>();
posts.forEach((p) => counts.set(p.data.project, (counts.get(p.data.project) ?? 0) + 1));
const projects = order.filter((p) => counts.has(p));

const fmt = (d: Date) =>
  d.toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" });
---
<BaseLayout title="김휘래 개발 기록" here="posts">
  <main id="content" class="app__main">
    <p class="eyebrow">MEASURED, NOT ASSUMED</p>
    <h1 class="home-title">문제를 정의하고 서비스로 증명해왔습니다</h1>
    <p class="home-lead">
      정답이 하나가 아닌 자리에서 무엇을 고르고 무엇을 버렸는지, 그 근거를 직접 잰 숫자와 함께 적습니다.
      글에 나오는 코드는 실제 저장소의 코드입니다.
    </p>

    <div class="app__head">
      <h2>글</h2>
      <span class="tnum" id="list-count">{posts.length}편</span>
    </div>

    <div class="post-list">
      {posts.map((post) => (
        <a class="post-row" href={`/posts/${post.id}/`} data-project={post.data.project}>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <div class="post-row__rail">
            <b>{post.data.project}</b>
            <time class="tnum" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<script>
  // 사이드바의 프로젝트 링크는 어느 페이지에서나 /?project=X 로 간다.
  // 홈에서는 이동 대신 그 자리에서 거른다.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".rail__group [data-filter]")];
  const rows = [...document.querySelectorAll<HTMLElement>(".post-row")];
  const countEl = document.getElementById("list-count");

  function apply(key: string) {
    const visible = rows.filter((row) => {
      const match = key === "all" || row.dataset.project === key;
      row.hidden = !match;
      return match;
    });
    links.forEach((a) => a.toggleAttribute("aria-current", a.dataset.filter === key));
    if (countEl) countEl.textContent = `${visible.length}편`;
  }

  links.forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      const key = a.dataset.filter!;
      history.replaceState(null, "", key === "all" ? "/" : `/?project=${encodeURIComponent(key)}`);
      apply(key);
    })
  );

  apply(new URLSearchParams(location.search).get("project") ?? "all");
</script>
