---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const order = ["케이톡", "레인보우TV", "아주이벤트", "메일상자", "아올다 클라우드", "공통", "회고"];
const counts = new Map<string, number>();
posts.forEach((p) => counts.set(p.data.project, (counts.get(p.data.project) ?? 0) + 1));
const projects = order.filter((p) => counts.has(p));
---
<BaseLayout title="김휘래 개발 기록">
  <div class="shell" style="--measure: 800px">
    <main id="content">
      <h1 class="home-title">문제를 정의하고 서비스로 증명해왔습니다</h1>
      <p class="home-lead">
        불편을 그냥 넘기지 않고 해결할 문제로 정의한 뒤 직접 만들어 운영했습니다.
        교내 공지를 조건에 맞게 밀어주는 아주이벤트는 가입자 466명에 MAU 300명,
        여러 계정의 메일을 한곳에서 보는 메일상자는 가입자 322명이 쓰고 있어요.
      </p>
      <p class="home-note">
        정답이 하나가 아닌 자리에서 무엇을 고르고 무엇을 버렸는지, 그 근거를 직접 잰 숫자와 함께 적습니다.
      </p>

      <div class="filters" role="group" aria-label="프로젝트 필터">
        <button type="button" data-filter="all" aria-pressed="true">전체 {posts.length}</button>
        {projects.map((p) => (
          <button type="button" data-filter={p} aria-pressed="false">{p} {counts.get(p)}</button>
        ))}
      </div>

      <div class="post-list">
        {posts.map((post) => (
          <article
            class:list={["post-row", !post.data.cover && "post-row--no-cover"]}
            data-project={post.data.project}
          >
            <div>
              <div class="post-row__meta">
                <b>{post.data.project}</b>
                <span>·</span>
                <time class="tnum" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("ko-KR", {
                    year: "numeric", month: "2-digit", day: "2-digit",
                  })}
                </time>
              </div>
              <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <div class="tags">
                {post.data.tags.map((t) => <span>{t}</span>)}
              </div>
            </div>
            {post.data.cover && (
              <Image
                class="post-row__cover"
                src={post.data.cover}
                alt={post.data.coverAlt ?? ""}
                width={400}
                height={264}
                loading="lazy"
              />
            )}
          </article>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const rows = [...document.querySelectorAll<HTMLElement>(".post-row")];

  function applyFilter(key: string) {
    const visible = rows.filter((row) => {
      const match = key === "all" || row.dataset.project === key;
      row.hidden = !match;
      // :last-child 는 숨은 행까지 세므로 마지막으로 "보이는" 행을 직접 표시한다.
      row.classList.remove("is-last");
      return match;
    });
    visible.at(-1)?.classList.add("is-last");
  }

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const key = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      applyFilter(key);
    })
  );
</script>
